project_id           = "your-gcp-project-id"
region               = "us-central1"
template_name_prefix = "local-llm-gemma4-tpl"

# ==============================================================================
# GPU Type Configuration
# Leave empty ("") or null to deploy CPU-only without a GPU.
# Possible GCP GPU values:
#   - ""                      : CPU-only (no GPU attached)
#   - "nvidia-l4"             : NVIDIA L4 (24 GB VRAM) — requires g2-standard-* machine type
#   - "nvidia-tesla-t4"       : NVIDIA T4 (16 GB VRAM) — requires n1-* machine type
#   - "nvidia-tesla-v100"     : NVIDIA V100 (16 GB VRAM) — requires n1-* machine type
#   - "nvidia-tesla-p100"     : NVIDIA P100 (16 GB VRAM) — requires n1-* machine type
#   - "nvidia-tesla-p4"       : NVIDIA P4 (8 GB VRAM) — requires n1-* machine type
#   - "nvidia-tesla-a100"     : NVIDIA A100 (40 GB VRAM) — requires a2-highgpu-* machine type
#   - "nvidia-a100-80gb"      : NVIDIA A100 (80 GB VRAM) — requires a2-ultragpu-* machine type
#   - "nvidia-h100-80gb"      : NVIDIA H100 (80 GB VRAM) — requires a3-highgpu-* machine type
# ==============================================================================
gpu_type = "nvidia-l4"

# ==============================================================================
# VM Machine Type (e.g., "g2-standard-4", "g2-standard-8", "n4-standard-4", "n4-standard-8", "n4-highmem-8")
# Leave as "" to let Terraform pick the default ("g2-standard-8" for GPU or "n4-standard-8" when gpu_type = "").
# ==============================================================================
machine_type = ""

# ==============================================================================
# Gemma 4 Model Size ("e2b", "e4b", "12b", "26b", or "31b")
# ==============================================================================
gemma_model_size = "e4b"

# ==============================================================================
# Boot Disk Size (in GB)
# ==============================================================================
boot_disk_size_gb = 100

# ==============================================================================
# Nginx HTTP Basic Authentication Credentials (Port 443)
# ==============================================================================
auth_username = "admin"
auth_password = "replace-with-strong-password"

# Optional: Use Spot VM for ~60-70% cost reduction
use_spot_vm = false
